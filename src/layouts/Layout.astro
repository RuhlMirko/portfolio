---
const title = "Mirko Ruhl • Full Stack | Portfolio";
const description =
  "Full Stack Developer & UX/UI Designer | Building beautiful themed and pleseant digital experiences";
const url = "https://ruhlmirko.github.io/portfolio/";
const image = `${url}/preview.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text x='50' y='70' font-size='70' font-weight='bold' text-anchor='middle' fill='white' font-family='sans-serif'>MR</text></svg>"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text x='50' y='70' font-size='70' font-weight='bold' text-anchor='middle' fill='black' font-family='sans-serif'>MR</text></svg>"
      media="(prefers-color-scheme: light)"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --faint-border: rgb(163, 163, 163);
    --text-primary: #f4f7fb;
    --text-secondary: rgba(226, 233, 241, 0.88);
    --text-muted: rgba(219, 225, 231, 0.74);
    --title-shadow: 0 8px 22px rgba(0, 0, 0, 0.34);
    --inner-shadow: inset 0 0 3rem rgba(0, 0, 0, 0.637);
    --glass-bg: linear-gradient(
      160deg,
      #555454 4%,
      #414141 15%,
      rgba(34, 34, 34, 0.5) 50%,
      rgba(48, 48, 48, 0.3)
    );

    --grid-size: 20px;
    --grid-line: rgba(255, 255, 255, 0.031);
    --aero-blue: linear-gradient(
      to bottom,
      #6e8dc3 0%,
      #6e8dc3 20%,
      #1d329d 35%,
      #1d329d 65%,
      #135197 80%,
      #2593c8 95%
    );
    --aero-black: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.25) 0,
      rgba(117, 117, 117, 0.15) 20%,
      rgba(0, 0, 0, 0.3) 35%,
      rgba(0, 0, 0, 0.4) 65%,
      rgba(27, 27, 27, 0.3) 80%,
      rgba(41, 41, 41, 0.3) 95%
    );
    --aero-green: linear-gradient(
      to bottom,
      #64b472 0%,
      #458643 20%,
      #0f5312 35%,
      #125f16 65%,
      #147011 80%,
      #20991c 95%
    );
    --aero-white: linear-gradient(
      to bottom,
      hsl(0, 0%, 43%) 0%,
      hsl(0, 2%, 77%) 20%,
      hsl(0, 1%, 54%) 35%,
      hsl(0, 0%, 52%) 65%,
      hsl(0, 0%, 58%) 80%,
      hsl(0, 0%, 27%) 95%
    );
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    overflow-x: clip;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }
  section {
    position: relative;
    margin-block: 0;
    padding-block: clamp(1rem, 2vw, 1.5rem);
  }

  hr {
    border: none;
    border-top: 1px solid var(--faint-border);
    height: 0;
    margin-bottom: 1rem;
  }

  .site-main {
    width: min(100%, 1180px);
    margin: 0 auto;
    padding-inline: 0.5rem;
    padding-top: clamp(4rem, 8vw, 6rem);
    display: block;
  }

  .site-main > section {
    width: min(100%, 1180px);
    margin-inline: auto;
  }

  body {
    color: var(--text-primary);
    background: linear-gradient(
      to right,
      #050505 0%,
      #111111 42%,
      #050505 100%
    );
    &::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: radial-gradient(circle at center, black 50%, transparent 98%);
    }
    background-attachment: fixed;
    font-family:
      "Nunito",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  section {
    margin-bottom: 5rem;
  }
  @media (max-width: 1200px) {
    body {
      padding-inline: 0;
    }
  }
  h1,
  h2,
  h3 {
    font-family: "Jost", "Segoe UI";
    letter-spacing: 0.08em;
    line-height: 1.05;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(3rem, 7vw, 4.8rem);
    text-shadow: var(--title-shadow);
  }
  h2 {
    font-size: clamp(2.1rem, 4vw, 3.15rem);
    padding-bottom: 0.5rem;
    text-align: center;
    text-shadow: var(--title-shadow);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    letter-spacing: 0.04em;
  }
  p {
    color: var(--text-secondary);
    font-weight: 400;
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.75;
    text-wrap: pretty;
  }
  li {
    color: var(--text-secondary);
    line-height: 1.65;
  }
  a {
    color: inherit;
  }
  small,
  .muted {
    color: var(--text-muted);
  }
  .section-title {
    text-align: center;
    background: var(--aero-black);
    border: 4px solid rgb(70, 70, 70);
    box-shadow: 0 5px 5px rgba(0, 0, 0, 0.548);
    margin-bottom: 12px;
    border-radius: 25px;
    padding-inline: 1rem;
  }

  ::selection {
    background: rgba(97, 161, 255, 0.35);
    color: #fff;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateX(150px);
    transition:
      opacity 0.5s ease-out,
      transform 1s ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  // ######### SMOOTH SCROLL ######### //
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";
  const lenis = new Lenis();
  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);

  // ######### REVEAL UP ANIMATION ######### //
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll("[data-reveal]").forEach((el) => {
    revealObserver.observe(el);
  });
</script>
